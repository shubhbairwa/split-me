rules_version = '2';

// Matches how the app currently queries Firestore: DashboardViewModel,
// GroupViewModel, MemberViewModel and BillViewModel all listen to entire
// collections (groups, members, bills, shares) rather than per-user
// filtered queries, and "members" are plain contacts (not necessarily
// other Firebase Auth accounts), so their doc id isn't always the
// signed-in user's uid. A rule that only allows a user to read documents
// naming their own uid would make those collection-wide listeners fail
// with PERMISSION_DENIED (Firestore rejects a listener/query unless it
// can prove every possible result satisfies the rule).
//
// This rule set instead requires only that the caller be signed in to
// the app, matching that shared-data design. If group/bill data should
// later be restricted to only the members of a given group, the queries
// in FirestoreGroupRepository/FirestoreBillRepository/FirestoreMemberRepository
// need to change to per-group/per-user filtered reads first, and the
// rules below tightened to match.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
