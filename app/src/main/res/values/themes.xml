<resources>

    <!-- DayNight follows the system light/dark setting. Compose screens get their colors
         from SplitMeTheme; this only styles the window (background shown before Compose
         draws, system bars) so it matches the active mode. -->
    <style name="Theme.SplitMe" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="colorPrimary">@color/accent_orange</item>
    </style>
</resources>
